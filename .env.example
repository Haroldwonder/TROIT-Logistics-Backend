# TROIT Logistics Backend — Local Environment Configuration Example

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/troit_logistics

# Server Network Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000

# Structured Logging Level (trace, debug, info, warn, error)
RUST_LOG=info,troit_logistics_backend=debug

# JWT Secret Key (MUST be changed in production environments)
JWT_SECRET=troit_local_dev_jwt_secret_key_change_in_prod_1234567890

# JWT Token Expiration Duration (in hours)
JWT_EXPIRATION_HOURS=24

# Stellar Blockchain & Soroban RPC Configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_ESCROW_CONTRACT_ID=
SOROBAN_ADMIN_SECRET_KEY=

# Cloudflare R2 / S3 Object Storage Configuration (Phase 5F)
STORAGE_PROVIDER=r2
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
MAX_IMAGE_SIZE_MB=5
